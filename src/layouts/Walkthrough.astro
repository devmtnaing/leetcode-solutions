---
/* The skeleton every solution page shares: header, part 1 (statement,
 * widget, example cards, traps), part 2 (2·1 and 2·2 rendered by the stepper
 * into #lesson, then 2·3 going deeper), and part 3 (the solution blocks).
 * lesson.css styles it; kit.css styles the stage shapes inside it.
 *
 * Every reader-facing prop takes a plain string or an { en, my } pair. HTML is
 * allowed in the prose props. The interactive parts — the widget, the example
 * cards, the whole of part 2 and the part 3 solution blocks — are rendered by
 * the lesson's script into the #q-widget, #examples, #lesson and #solutions
 * mounts below. The play hint sits after #lesson so it still shows without
 * JavaScript; the stepper moves it to the foot of 2·2, under the player.
 */
import Base from './Base.astro';
import { REPO, SITE_NAME } from '../data/site';
import '../styles/lesson.css';
import '../styles/kit.css';

type T = string | { en: string; my?: string };
interface Link { id: number; title: string; slug: string; difficulty: 'Easy' | 'Medium' | 'Hard' }
interface Note { q: T; a: T }

interface Props {
  /** The lesson folder under src/lessons/, so the page can load its script. */
  slug: string;
  title: T;
  summary: string;
  eyebrow: T;
  lede: T;
  links: Link[];
  statement: string;          // raw HTML, data-i18n already on its elements
  constraints: T;
  part1Sub: T;
  widgetTitle: T;
  traps: { summary: T; items: T[] };
  part2Sub: T;
  notes: { eyebrow: T; title: T; items: Note[] };
  cost: { eyebrow: T; title: T; html: T };
  part3Sub: T;
  /** The keyboard and edit hint, shown under the player in 2·2. */
  playHint: T;
  /** A lesson's own style.css, when it has one; inlined on its page only. */
  css?: string;
}
// Every prop is supplied by the lesson's page.js; scripts/check-lessons.mjs
// fails a lesson that leaves one out.
const p = Astro.props;
// A new issue from the "page problem" form, already naming this page.
const issueUrl = `${REPO}/issues/new?${new URLSearchParams({
  template: 'page-problem.yml',
  title: `[${p.slug}] `,
  page: new URL(`/leetcode/${p.slug}`, Astro.site).href,
})}`;
const en = (v?: T) => (v == null ? '' : typeof v === 'string' ? v : v.en);
const my = (v?: T) => (v == null || typeof v === 'string' ? undefined : v.my);
const plain = (v: T) => en(v).replace(/<[^>]+>/g, '');
const lcUrl = (slug: string) => `https://leetcode.com/problems/${slug}/`;
---
<Base title={`${plain(p.title)} · ${SITE_NAME}`} description={p.summary}>
<div class="shell">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">LeetCode</a><span>/</span>
    <span>{plain(p.title)}</span>
  </nav>
</div>

<div class="wrap">
  {p.css && <style is:inline set:html={p.css} />}
  <header>
    <div class="top-row">
      <span class="eyebrow" data-i18n={my(p.eyebrow)} set:html={en(p.eyebrow)} />
      <div class="lang-switch" role="group" aria-label="Page language">
        <button class="lang-opt" data-lang-opt="en" aria-pressed="true">English</button>
        <button class="lang-opt" data-lang-opt="my" aria-pressed="false" lang="my">မြန်မာ</button>
      </div>
    </div>
    <h1 set:html={en(p.title)} />
    <p class="lede" data-i18n={my(p.lede)} set:html={en(p.lede)} />
    <nav class="jump">
      <a href="#part-1"><b>1</b> <span data-i18n="မေးခွန်း">The question</span></a>
      <a href="#part-2"><b>2</b> <span data-i18n="အဖြေ">The answer</span></a>
      <a href="#part-3"><b>3</b> <span data-i18n="Code">The code</span></a>
      {p.links.map((l) => (
        <a class="lc" href={lcUrl(l.slug)} target="_blank" rel="noopener">
          {p.links.length > 1 && <b>{l.id}</b>}
          <span data-i18n="LeetCode တွင် ကြည့်ရန် ↗">View on LeetCode ↗</span>
        </a>
      ))}
    </nav>
  </header>

  <!-- ============ 1 · the question ============ -->
  <div class="part" id="part-1">
    <span class="part-n">1</span>
    <div class="part-text">
      <h2 data-i18n="မေးခွန်း">The question</h2>
      <p data-i18n={my(p.part1Sub)} set:html={en(p.part1Sub)} />
    </div>
  </div>

  <section class="question">
    <div class="q-statement">
      <div class="q-head">
        <h2 data-i18n="ပုစ္ဆာ">The problem</h2>
        <span class="q-src" data-i18n="LeetCode မှ ကူးယူဖော်ပြသည်">quoted from LeetCode</span>
      </div>
      <div class="statement" set:html={p.statement} />
      {p.constraints && <div class="constraints" data-i18n={my(p.constraints)} set:html={en(p.constraints)} />}
      <div class="source-links">
        {p.links.map((l) => (
          <a class="plink" href={lcUrl(l.slug)} target="_blank" rel="noopener">
            <span class="pnum">{l.id}</span> {l.title} <span class={`pdiff ${l.difficulty.toLowerCase()}`}>{l.difficulty}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="q-play panel">
      <div class="panel-head">
        <h2 data-i18n={my(p.widgetTitle)} set:html={en(p.widgetTitle)} />
        <span class="note" id="q-label"></span>
      </div>
      <div id="q-widget"></div>
    </div>
  </section>

  <div class="ex-grid" id="examples"></div>

  <details class="disclose">
    <summary><span data-i18n={my(p.traps.summary)} set:html={en(p.traps.summary)} /></summary>
    <div class="disclose-body">
      <ul class="why">
        {p.traps.items.map((t) => <li data-i18n={my(t)} set:html={en(t)} />)}
      </ul>
    </div>
  </details>

  <!-- ============ 2 · the answer ============ -->
  <div class="part" id="part-2">
    <span class="part-n">2</span>
    <div class="part-text">
      <h2 data-i18n="အဖြေ — အဆင့်ဆင့်">The answer, step by step</h2>
      <p data-i18n={my(p.part2Sub)} set:html={en(p.part2Sub)} />
    </div>
  </div>

  <div id="lesson" data-slug={p.slug}>
    <noscript><p>The walkthrough needs JavaScript. The whole solution is in part 3 either way.</p></noscript>
  </div>
  <p class="play-hint" id="play-hint" data-i18n={my(p.playHint)} set:html={en(p.playHint)} />

  <section class="subsec">
    <div class="subsec-head">
      <span class="subsec-n">2·3</span>
      <h3 data-i18n="ပိုနက်နက် သိရန်">Going deeper</h3>
    </div>
    <div class="deeper">
      {p.cost && (
        <div class="deeper-block">
          <span class="eyebrow" data-i18n={my(p.cost.eyebrow)} set:html={en(p.cost.eyebrow)} />
          <h4 data-i18n={my(p.cost.title)} set:html={en(p.cost.title)} />
          <figure class="cost" data-i18n={my(p.cost.html)} set:html={en(p.cost.html)} />
        </div>
      )}
      {p.notes && (
        <div class="deeper-block">
          <span class="eyebrow" data-i18n={my(p.notes.eyebrow)} set:html={en(p.notes.eyebrow)} />
          <h4 data-i18n={my(p.notes.title)} set:html={en(p.notes.title)} />
          <div class="notes">
            {p.notes.items.map((n) => (
              <details class="disclose">
                <summary><span data-i18n={my(n.q)} set:html={en(n.q)} /></summary>
                <div class="disclose-body"><p data-i18n={my(n.a)} set:html={en(n.a)} /></div>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ============ 3 · the code ============ -->
  <div class="part" id="part-3">
    <span class="part-n">3</span>
    <div class="part-text">
      <h2 data-i18n="အဖြေ code အပြည့်အစုံ">The whole solution</h2>
      <p data-i18n={my(p.part3Sub)} set:html={en(p.part3Sub)} />
    </div>
  </div>
  <div id="solutions"></div>

  <aside class="report" aria-labelledby="report-h">
    <h3 id="report-h" data-i18n="အမှား တွေ့သလား။">Spot a mistake?</h3>
    <p data-i18n="ဤ site ၏ source code သည် GitHub ပေါ်တွင် public ဖြစ်သည်။ bug၊ မှားသော အဖြေ၊ ရှုပ်ထွေးသော အဆင့် သို့မဟုတ် ဘာသာပြန် အမှားကို issue တစ်ခုအဖြစ် report လုပ်နိုင်သည် — ပြင်ဆင်ချက် pull request များကိုလည်း ကြိုဆိုသည်။">This site's source is public on GitHub. A bug, a wrong answer, a step that doesn't add up or a clumsy translation can be reported there as an issue — and pull requests with a fix are welcome too.</p>
    <div class="report-links">
      <a class="plink" href={issueUrl} target="_blank" rel="noopener" data-i18n="ဤစာမျက်နှာအတွက် issue report လုပ်ရန် ↗">Report an issue with this page ↗</a>
      <a class="plink" href={`${REPO}/tree/main/src/lessons/${p.slug}`} target="_blank" rel="noopener" data-i18n="ဤစာမျက်နှာ၏ source ကို ကြည့်ရန် ↗">View this page's source ↗</a>
    </div>
  </aside>
</div>

<div class="shell">
  <nav class="pager" aria-label="Lesson navigation">
    <a class="up" href="/"><span class="dir">Back to</span><span>All problems</span></a>
  </nav>
</div>
</Base>

<script>
  import { initLangSwitch } from '../lib/i18n.js';
  initLangSwitch();
</script>
