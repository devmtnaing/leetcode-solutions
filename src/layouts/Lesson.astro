---
import Base from './Base.astro';
import { SITE_NAME } from '../data/site';

interface Props {
  title: string;
  summary: string;
  interactive?: boolean;
  /** A walkthrough page draws its own title inside the stage; prose pages don't. */
  ownHeader?: boolean;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
  /** Where this lesson sits, for a lesson with nothing after it. */
  up?: { href: string; title: string };
}
const { title, summary, interactive = false, ownHeader = false, prev, next, up } = Astro.props;
---
<Base title={`${title} · ${SITE_NAME}`} description={summary} interactive={interactive}>
  <div class="shell">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">LeetCode Problems</a><span>/</span>
      <span>{title}</span>
    </nav>
  </div>

  {!ownHeader && (
    <div class="shell">
      <div class="page-head">
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </div>
    </div>
  )}

  <slot />

  {(prev || next || up) && (
    <div class="shell">
      <nav class="pager" aria-label="Lesson navigation">
        {prev && <a href={prev.href}><span class="dir">Previous</span><span>{prev.title}</span></a>}
        {up && !prev && <a class="up" href={up.href}><span class="dir">Back to</span><span>{up.title}</span></a>}
        {next && <a class="next" href={next.href}><span class="dir">Next</span><span>{next.title}</span></a>}
      </nav>
    </div>
  )}
</Base>
