---
import Base from './Base.astro';
import { trackById } from '../data/tracks';

interface Props {
  title: string;
  summary: string;
  track: string;
  interactive?: boolean;
  /** A walkthrough page draws its own title inside the stage; prose pages don't. */
  ownHeader?: boolean;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}
const { title, summary, track, interactive = false, ownHeader = false, prev, next } = Astro.props;
const t = trackById(track);
---
<Base title={`${title} · learn`} description={summary} interactive={interactive}>
  <div class="shell">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">learn</a><span>/</span>
      <a href={`/${track}`}>{t?.name ?? track}</a><span>/</span>
      <span>{title}</span>
    </nav>
  </div>

  {!ownHeader && (
    <div class="shell">
      <div class="page-head">
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </div>
    </div>
  )}

  <slot />

  {(prev || next) && (
    <div class="shell">
      <nav class="pager" aria-label="Lesson navigation">
        {prev && <a href={prev.href}><span class="dir">Previous</span><span>{prev.title}</span></a>}
        {next && <a class="next" href={next.href}><span class="dir">Next</span><span>{next.title}</span></a>}
      </nav>
    </div>
  )}
</Base>
