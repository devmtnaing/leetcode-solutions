---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../data/site';
import problems from '../data/problems.json';

interface Problem {
  id: number; title: string; slug: string; difficulty: string;
  paid: boolean; acRate: string; tags: string[]; extra?: boolean;
}

// A problem gets a walkthrough link when a lesson folder names it: every
// lesson's page.js lists the LeetCode problems it covers.
const pages = import.meta.glob('../lessons/*/page.js', { eager: true, import: 'default' }) as
  Record<string, { links: { id: number }[] }>;
const WALKTHROUGH: Record<number, string> = {};
for (const [path, page] of Object.entries(pages)) {
  const slug = path.split('/').at(-2);
  for (const { id } of page.links) WALKTHROUGH[id] = `/leetcode/${slug}`;
}

// Outside the core list, but they have a walkthrough, so they are listed with
// their difficulty rather than hidden.
const EXTRA: Record<string, Problem[]> = {
  EASY: [{ id: 3318, title: 'Find X-Sum of All K-Long Subarrays I', slug: 'find-x-sum-of-all-k-long-subarrays-i', difficulty: 'Easy', paid: false, acRate: '75.8%', tags: ['Array', 'Hash Table', 'Sliding Window'], extra: true }],
  HARD: [{ id: 3321, title: 'Find X-Sum of All K-Long Subarrays II', slug: 'find-x-sum-of-all-k-long-subarrays-ii', difficulty: 'Hard', paid: false, acRate: '41.1%', tags: ['Array', 'Hash Table', 'Sliding Window'], extra: true }],
};

const groups = (['EASY', 'MEDIUM', 'HARD'] as const).map((key) => ({
  key,
  label: key[0] + key.slice(1).toLowerCase(),
  rows: [...((problems as Record<string, Problem[]>)[key] ?? []), ...(EXTRA[key] ?? [])],
}));
const core = Object.values(problems as Record<string, Problem[]>).flat().length;
const all = groups.flatMap((g) => g.rows);
const worked = all.filter((p) => WALKTHROUGH[p.id]).length;
---
<Base
  title={`LeetCode · ${SITE_NAME}`}
  description="A roadmap of interview problems, worked one at a time — each with an interactive walkthrough and verified solutions in five languages."
>
  <div class="shell">
    <div class="page-head">
      <h1>LeetCode</h1>
      <p class="lede">
        {core} problems, split evenly across easy, medium and hard, chosen where three
        separate study plans agree. Open a problem to see its interactive solution: a
        page that runs the algorithm step by step, with solutions in Ruby, Python,
        JavaScript, Go and Rust that were all run before they were published.
      </p>
    </div>

    {groups.map((g) => (
      <section class="roadmap">
        <h2>{g.label} <span class="num" style="color:var(--ink-3);font-weight:400;font-size:15px">— {g.rows.length} problems</span></h2>
        <div class="tablewrap">
          <table class="problems">
            <thead>
              <tr>
                <th style="width:1%">#</th>
                <th>Problem</th>
                <th class="wide">Pattern</th>
                <th class="wide" style="width:1%">Level</th>
                <th class="wide" style="width:1%;text-align:right">Accepted</th>
              </tr>
            </thead>
            <tbody>
              {g.rows.map((p) => (
                <tr class={WALKTHROUGH[p.id] ? 'has-page' : undefined}>
                  <td class="num">{p.id}</td>
                  <td>
                    {WALKTHROUGH[p.id]
                      ? <a class="title" href={WALKTHROUGH[p.id]}>{p.title}</a>
                      : <span class="title">{p.title}</span>}
                    <span class="sub">
                      {!WALKTHROUGH[p.id] && <span class="soon">Solution coming soon</span>}
                      {p.extra && <span>Outside the core list</span>}
                      <a class="lc" href={`https://leetcode.com/problems/${p.slug}/`} target="_blank" rel="noopener">View on LeetCode ↗</a>
                    </span>
                  </td>
                  <td class="tags wide">{p.tags.slice(0, 3).join(' · ')}</td>
                  <td class="wide"><span class={`diff ${p.difficulty.toLowerCase()}`}>{p.difficulty}</span></td>
                  <td class="rate wide">{p.acRate}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <p class="note" style="color:var(--ink-3);font-size:13px;padding-bottom:50px">
      {worked} of {all.length} problems have an interactive solution. Metadata pulled from LeetCode and
      verified problem by problem — difficulty labels here match the site, not folklore.
    </p>
  </div>
</Base>
