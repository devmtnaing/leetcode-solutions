---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Lesson from '../../layouts/Lesson.astro';

// One route for every prose lesson in every track. Interactive walkthroughs get
// their own page file instead, because each one ships a script of its own and a
// shared route would bundle every lesson's script into every lesson.
export const getStaticPaths: GetStaticPaths = async () => {
  const all = (await getCollection('lessons', ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order);

  return all.map((entry) => {
    const slug = entry.id.replace(/\.mdx?$/, '').split('/').slice(1).join('/');
    const siblings = all.filter((e) => e.data.track === entry.data.track);
    const i = siblings.indexOf(entry);
    const link = (e: (typeof all)[number]) => ({
      href: `/${e.data.track}/${e.id.replace(/\.mdx?$/, '').split('/').slice(1).join('/')}`,
      title: e.data.title,
    });
    return {
      params: { track: entry.data.track, slug },
      props: {
        entry,
        prev: i > 0 ? link(siblings[i - 1]!) : undefined,
        next: i < siblings.length - 1 ? link(siblings[i + 1]!) : undefined,
      },
    };
  });
};

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---
<Lesson
  title={entry.data.title}
  summary={entry.data.summary}
  track={entry.data.track}
  prev={prev}
  next={next}
>
  <div class="shell">
    <article class="prose"><Content /></article>
  </div>
</Lesson>
